# ===========================
# CHATBOT NÔNG NGHIỆP - ENV
# ===========================
# Sao chép file này thành .env và điền thông tin thật

# --- Gemini API ---
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- PostgreSQL (Tầng 1 facts + Tầng 2 KG) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chatbot_nongnghiep

# --- ChromaDB (Tầng 3 vector — tự động lưu vào chatbot/chroma_db/) ---
# Không cần cấu hình thêm, ChromaDB chạy hoàn toàn local

# --- App Settings ---
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# --- Model Settings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-large
GEMINI_ROUTER_MODEL=gemini-1.5-flash
GEMINI_SYNTHESIS_MODEL=gemini-1.5-pro
